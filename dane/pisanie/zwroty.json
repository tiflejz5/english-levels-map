{
  "version": 1,
  "groups": [
    {
      "id": "opinia",
      "label": "Wyrażanie opinii",
      "description": "Jak powiedzieć, co myślisz – od prostego do formalnego.",
      "genres": ["essay", "article", "forum", "blog", "letter", "email", "review", "report"],
      "phrases": [
        { "id": "opinia-01", "en": "In my opinion, …", "pl": "Moim zdaniem…", "level": "B1", "register": "neutral" },
        { "id": "opinia-02", "en": "I think/believe that …", "pl": "Myślę/uważam, że…", "level": "B1", "register": "neutral" },
        { "id": "opinia-03", "en": "To be honest, …", "pl": "Szczerze mówiąc…", "level": "B1", "register": "informal", "genres": ["email", "blog", "forum"] },
        { "id": "opinia-04", "en": "As far as I'm concerned, …", "pl": "Jeśli o mnie chodzi…", "level": "B2", "register": "neutral" },
        { "id": "opinia-05", "en": "I am firmly convinced that …", "pl": "Jestem głęboko przekonany, że…", "level": "B2", "register": "formal", "example": "I am firmly convinced that schools should teach first aid.", "note": "Mocniejsze niż I think – dobre w rozprawce, przesadne w e-mailu do kolegi." },
        { "id": "opinia-06", "en": "It seems to me that …", "pl": "Wydaje mi się, że…", "level": "B2", "register": "neutral", "note": "Łagodniejsze niż I think – przydaje się, gdy temat jest sporny." },
        { "id": "opinia-07", "en": "There is no denying that …", "pl": "Nie da się zaprzeczyć, że…", "level": "C1", "register": "formal", "example": "There is no denying that social media has changed the way we communicate.", "genres": ["essay", "article", "report"] },
        { "id": "opinia-08", "en": "I would argue that …", "pl": "Twierdziłbym, że…", "level": "C1", "register": "formal", "note": "Ostrożne, akademickie – typowe w eseju C1." }
      ]
    },
    {
      "id": "kontrargument",
      "label": "Kontrargument i ustępstwo",
      "description": "Przyznaj rację drugiej stronie, zanim przedstawisz swój argument.",
      "genres": ["essay", "article", "letter", "forum", "report", "proposal"],
      "phrases": [
        { "id": "kontrargument-01", "en": "However, …", "pl": "Jednak…", "level": "B1", "register": "neutral", "note": "Na początku zdania z przecinkiem. Nie łącz nim dwóch zdań przecinkiem w środku." },
        { "id": "kontrargument-02", "en": "Although …, …", "pl": "Chociaż…, …", "level": "B1", "register": "neutral", "example": "Although the tickets are expensive, the concert is worth it." },
        { "id": "kontrargument-03", "en": "On the other hand, …", "pl": "Z drugiej strony…", "level": "B1", "register": "neutral" },
        { "id": "kontrargument-04", "en": "Some people claim that …. However, …", "pl": "Niektórzy twierdzą, że…. Jednak…", "level": "B2", "register": "neutral", "genres": ["essay", "article", "forum"] },
        { "id": "kontrargument-05", "en": "While it is true that …, …", "pl": "Choć prawdą jest, że…, …", "level": "B2", "register": "formal", "example": "While it is true that online courses are cheaper, they require a lot of self-discipline." },
        { "id": "kontrargument-06", "en": "Admittedly, …", "pl": "Trzeba przyznać, że…", "level": "C1", "register": "formal" },
        { "id": "kontrargument-07", "en": "This is not to say that …", "pl": "Nie znaczy to, że…", "level": "C1", "register": "formal", "example": "This is not to say that technology has no place in the classroom." },
        { "id": "kontrargument-08", "en": "Be that as it may, …", "pl": "Tak czy inaczej… / Niemniej jednak…", "level": "C1", "register": "formal", "note": "Bardzo formalne – używaj raz w tekście, nie częściej." }
      ]
    }
  ]
}

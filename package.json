{
  "name": "english-levels-map",
  "private": true,
  "version": "1.0.0",
  "description": "Mapa umiejętności z angielskiego A1–C2. Strona działa bez budowania; npm służy tylko do pobrania fontów, ikon i GSAP, które skrypt kopiuje do assets/.",
  "scripts": {
    "zasoby": "node tools/zbuduj-zasoby.js",
    "dane": "node tools/zbuduj-niezbednik.js",
    "build": "node tools/zbuduj-zasoby.js && node tools/zbuduj-niezbednik.js",
    "test": "node tools/testy.js"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "gsap": "^3.15.0",
    "lucide-static": "^1.59.0"
  }
}
